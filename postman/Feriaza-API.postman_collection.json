{
  "info": {
    "name": "Feriaza API v1",
    "description": "Colección de prueba de la API de Feriaza (docs/diseno-api.md). Ejecutar en orden: el registro y los logins guardan el token en variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "token_feriante",
      "value": ""
    },
    {
      "key": "token_coordinador",
      "value": ""
    },
    {
      "key": "email_prueba",
      "value": "api1@feriaza.test"
    }
  ],
  "item": [
    {
      "name": "Públicas",
      "item": [
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/categorias",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "categorias"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Trae las 5 categorías', () => pm.expect(pm.response.json().data.length).to.eql(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro de feriante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/feriantes/registro",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "feriantes",
                "registro"
              ]
            },
            "description": "Cambiar email_prueba en las variables para registrar otro feriante.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Prueba\",\n  \"email\": \"{{email_prueba}}\",\n  \"password\": \"Prueba123\",\n  \"password_confirmation\": \"Prueba123\",\n  \"telefono\": \"3644000001\",\n  \"categoria_id\": 1\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve un token', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token_feriante', json.token);"
                ]
              }
            }
          ]
        },
